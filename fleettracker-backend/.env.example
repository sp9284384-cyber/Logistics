# Database
DB_URL=jdbc:mysql://localhost:3306/fleet_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=fleet
DB_PASSWORD=change-me

# Auth (must be at least 32 characters)
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_EXPIRY_MS=86400000

# React dashboard origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:5173

# Firebase push notifications (optional)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=

# Live location via WebSocket instead of polling (optional)
WEBSOCKET_ENABLED=false

# Keep location updates for N days
LOCATION_RETENTION_DAYS=7
