# Database
DATABASE_URL=postgresql+psycopg2://ganraj:CHANGE_ME@localhost:5432/ganraj_logistics

# Security — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=Ganraj Logistics Service
ENV=dev

# Notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=bookings@ganrajlogistics.in
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
